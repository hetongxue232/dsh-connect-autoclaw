{
  "name": "dsh-connect-autoclaw",
  "version": "2.6.0",
  "private": true,
  "type": "module",
  "description": "把本机 AutoClaw（智谱 zwork）的积分额度接成 DSH 模型 provider：装好即用，无需 Key；macOS/Windows/Linux 三平台 safeStorage 解密；账号池 / 自动换号 / 导入导出 / 兑换码 / 真实体积探针；界面一比一复刻 dsh-connect-trae 与 dsh-connect-workbuddy 的系列骨架。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "mcp/*.mjs",
    "README.md",
    "index.js",
    "client.js",
    "src/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "THIRD_PARTY_NOTICES.md",
    "INSTALL-TEST.md",
    "test/*.js",
    "LICENSE",
    "benchmarks"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5.0.0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.7-rc.1 <0.3.0-0",
    "@earendil-works/pi-ai": ">=1.3.0 <2.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "engines": {
    "dsh": ">=0.1.6-alpha.2 <0.3.0"
  },
  "scripts": {
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hetongxue232/dsh-connect-autoclaw.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "autoclaw",
    "zhipu",
    "glm",
    "deepseek-harness"
  ]
}
